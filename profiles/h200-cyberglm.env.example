# Current profile: CyberGLM on a single 8×H200 TDX CVM.
# For another model or GPU profile, copy this file and adjust every model and
# evidence binding before rendering. Keep the file untracked and seal secrets.
ATTEST_PROXY_IMAGE=ghcr.io/adverserialai/attest-proxy@sha256:309837aed54ad45e2a6222c8d8389d9a748cb9c991406d4833423c0ea8f7578c
GPU_EVIDENCE_COLLECTOR_IMAGE=ghcr.io/adverserialai/gpu-evidence-collector@sha256:9e9410515db77d4940a8b63c3604055cf666b9e4bd6590952f4270b5019d0de3
MODEL_MEASURER_IMAGE=ghcr.io/adverserialai/model-measurer@sha256:45a687a1a890e6a03092068125390c43637cb9d3b0136e8367f0e7479a2bb0ab
SGLANG_IMAGE=lmsysorg/sglang@sha256:b1259f3ea3275f66237c498ea388919729018bc9f01c3d638391e06e2cf3f469
MODEL_ID=lordx64/cyberglm
MODEL_WEIGHTS_VOLUME=cyberglm-data
SGLANG_MODEL_PATH=/data/cyberglm-fp8
MODEL_ARTIFACT_PATH=/cyberglm-fp8
SGLANG_TP_SIZE=8
SGLANG_MEM_FRACTION=0.8
SGLANG_CONTEXT_LENGTH=1048576
# Profile-owned flags. These are tested only for the stated GLM/H200 profile.
SGLANG_MODEL_OPTIONS='--trust-remote-code --kv-cache-dtype fp8_e4m3 --dsa-prefill-backend flashmla_sparse_q8 --dsa-decode-backend flashmla_kv --speculative-algorithm EAGLE --speculative-num-steps 5 --speculative-eagle-topk 1 --speculative-num-draft-tokens 6 --reasoning-parser glm45 --tool-call-parser glm47'
GPU_DRIVER=nvidia
GPU_COUNT=8
GPU_EVIDENCE_EXPECTED_TYPE=nvidia-cc
GPU_EVIDENCE_INTERVAL=300
NV_ATTESTATION_SERVICE_KEY=SECRET_REPLACE_WITH_NVIDIA_ATTESTATION_SERVICE_KEY
SGLANG_LOOPBACK_TOKEN=SECRET_REPLACE_WITH_RANDOM_32_BYTES
POLICY_ID=adverserial-policy/REPLACE_WITH_PUBLISHED_VERSION
CONFIDENTIAL_ACTIVATION=active # billing must keep CC_ALLOWED_MODELS empty until evidence and policy activation
COMPOSE_DIGEST=sha256:SELF # preflight replaces this with deployment_configuration_digest
MODEL_MANIFEST_FILE=/model-evidence/manifest.json
RUNTIME_DIGEST=sha256:b1259f3ea3275f66237c498ea388919729018bc9f01c3d638391e06e2cf3f469
ACME_EMAIL=ops@adverserial.ai
GANDI_PAT=SECRET_REPLACE_WITH_ONE_YEAR_TOKEN
ENTITLEMENT_JWKS_JSON={"keys":[REPLACE_WITH_BILLING_PUBLIC_JWK]}
METER_SIGNING_SEED=SECRET_REPLACE_WITH_32_BYTE_BASE64URL_ED25519_SEED
RECEIPT_SIGNING_SEED=SECRET_REPLACE_WITH_32_BYTE_BASE64URL_P256_SEED
METER_TLS_BUNDLE_B64=SECRET_REPLACE_WITH_BASE64URL_JSON_MTLS_BUNDLE
# The ingress must terminate TLS itself and require the client certificate above.
METER_URL=https://meter-ingress.adverserial.ai
