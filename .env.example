# Copy to a local, untracked deployment env file. Values marked SECRET belong
# in dstack sealed environment configuration, never here in source control.
ATTEST_PROXY_IMAGE=ghcr.io/adverserialai/attest-proxy@sha256:REPLACE_WITH_RELEASE_DIGEST
GPU_EVIDENCE_COLLECTOR_IMAGE=ghcr.io/adverserialai/gpu-evidence-collector@sha256:REPLACE_WITH_RELEASE_DIGEST
SGLANG_LOOPBACK_TOKEN=SECRET_REPLACE_WITH_RANDOM_32_BYTES
POLICY_ID=adverserial-policy/REPLACE_WITH_PUBLISHED_VERSION
COMPOSE_DIGEST=sha256:REPLACE_WITH_RENDERED_COMPOSE_DIGEST
MODEL_DIGEST=sha256:REPLACE_WITH_CANONICAL_MODEL_ARTIFACT_DIGEST
RUNTIME_DIGEST=sha256:REPLACE_AFTER_REAL_TDX_MEASUREMENT
ACME_EMAIL=ops@adverserial.ai
GANDI_PAT=SECRET_REPLACE_WITH_ONE_YEAR_TOKEN
ENTITLEMENT_JWKS_JSON={"keys":[REPLACE_WITH_BILLING_PUBLIC_JWK]}
METER_SIGNING_SEED=SECRET_REPLACE_WITH_32_BYTE_BASE64URL_ED25519_SEED
